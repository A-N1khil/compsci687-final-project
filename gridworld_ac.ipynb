    "plt.figure(figsize=(14, 7))\n",
    "for res in results:\n",
    "    rewards = res[\"episode_rewards\"]\n",
    "    smoothed_rewards = moving_average(rewards, window=50)\n",
    "    plt.plot(smoothed_rewards, alpha=0.8, label=res[\"config\"].label)\n",
    "\n",
    "plt.title(\"Actor-Critic on GridWorld: Smoothed Episode Rewards\")\n",
    "plt.xlabel(\"Episode\")\n",
    "plt.ylabel(\"Smoothed Reward (window=50)\")\n",
    "plt.axhline(0, color=\"gray\", linestyle=\"--\", linewidth=1)\n",
    "plt.legend()\n",
    "plt.grid(alpha=0.3)\n",
    "plt.show()\n"
   ]
