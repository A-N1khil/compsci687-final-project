    "def moving_average(x, w=50):\n",
    "    return np.convolve(x, np.ones(w)/w, mode='valid')\n",
    "\n",
    "rewards = best_result[\"episode_rewards\"]\n",
    "smoothed = moving_average(rewards, 50)\n",
    "\n",
    "plt.figure(figsize=(10,5))\n",
    "plt.plot(smoothed)\n",
    "plt.axhline(0, linestyle=\"--\", color=\"black\", alpha=0.5)\n",
    "plt.title(\"Actor-Critic on GridWorld — Smoothed Episode Reward\")\n",
    "plt.xlabel(\"Episode\")\n",
    "plt.ylabel(\"Reward (moving avg)\")\n",
    "plt.grid(alpha=0.3)\n",
    "plt.show()\n"
   ]
